1.yaml

apiVersion: v1
kind: Pod
metadata:
  name: tomcat-simple-pod2
  labels:
    env: dev
    app: devops-app
spec:
  containers:
  - name: tomcat
    image: tomcat:latest
    ports:
    - containerPort: 8080
      hostPort: 8080

