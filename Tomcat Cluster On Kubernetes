apiVersion: v1
kind: Pod
metadata:
  name: tomcat-complex-pod
  labels:
    env: dev
    app: devops-web-app
spec:
  containers:
  - name: http
    image: httpd:latest
    ports:
    - containerPort: 80
      hostPort: 8081
  - name: tomcat
    image: tomcat:latest
    ports:
    - containerPort: 8080
      hostPort: 8080

