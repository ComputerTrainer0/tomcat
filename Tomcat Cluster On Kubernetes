Section 11: Mastering - Kubernetes Probs With Tomcat Cluster (Liveness and Readiness)

============================================================

13.yaml

apiVersion: v1
kind: Pod
metadata:
  name: tomcat-pod
  labels:
    app: tomcat
spec:
  containers:
  - name: tomcat
    image: tomcat:latest
    ports:
    - containerPort: 8080
    volumeMounts:
    - name: war-volume
      mountPath: /usr/local/tomcat/webapps/
    readinessProbe:
      httpGet:
        path: /samples/
        port: 8080
      initialDelaySeconds: 30
      periodSeconds: 10
      timeoutSeconds: 5
      failureThreshold: 3
      successThreshold: 1
  volumes:
  - name: war-volume
    hostPath:
      path: /opt/content/v1/war/
      type: Directory



